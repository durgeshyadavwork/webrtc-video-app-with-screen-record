<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Audio-Only WebRTC Chat</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <header>
            <div class="logo">Voice Chat</div>
            <h1>PRP Voice Chat</h1>
            <p class="description">Connect with others through peer-to-peer audio calls</p>
        </header>
        
        <div class="main-content">
            <div class="audio-container">
                <h2><i class="fas fa-microphone"></i> Audio Controls</h2>
                
                <div class="audio-visualization">
                    <div class="visualizer" id="visualizer">
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                    </div>
                    <div class="audio-label">Your Audio Level</div>
                </div>
                
                <div class="volume-control">
                    <label for="volumeSlider">Microphone Volume:</label>
                    <input type="range" id="volumeSlider" min="0" max="100" value="100">
                    <span id="volumeValue">100%</span>
                </div>
            </div>
            
            <div class="controls">
                <div class="control-group">
                    <h2><i class="fas fa-sliders-h"></i> Connection Settings</h2>
                    <div class="button-group">
                        <button id="startButton">
                            <i class="fas fa-microphone"></i> Start Audio
                        </button>
                        <button id="stopButton" disabled>
                            <i class="fas fa-microphone-slash"></i> Stop Audio
                        </button>
                    </div>
                    
                    <input type="text" id="roomInput" placeholder="Enter room name">
                    
                    <div class="button-group">
                        <button id="createButton" class="call-button">
                            <i class="fas fa-plus-circle"></i> Create Room
                        </button>
                        <button id="joinButton" class="call-button">
                            <i class="fas fa-sign-in-alt"></i> Join Room
                        </button>
                        <button id="hangupButton" class="end-call-button" disabled>
                            <i class="fas fa-phone-slash"></i> End Call
                        </button>
                    </div>
                </div>
                
                <div class="control-group">
                    <h2><i class="fas fa-network-wired"></i> Connection Status</h2>
                    <div class="status">
                        <span class="connection-status disconnected"></span>
                        <span id="statusText">Disconnected</span>
                    </div>
                </div>
                
                <div class="control-group">
                    <h2><i class="fas fa-info-circle"></i> Participants</h2>
                    <div id="participantsList">
                        <div class="participant">No participants yet</div>
                    </div>
                </div>
                
                <div class="control-group">
                    <h2><i class="fas fa-info-circle"></i> How to Use</h2>
                    <ol class="steps">
                        <li>Click "Start Audio" to enable your microphone</li>
                        <li>Create a room or join an existing one with a room name</li>
                        <li>Share the room name with someone you want to talk with</li>
                        <li>Wait for the remote participant to join</li>
                        <li>Click "End Call" when finished</li>
                    </ol>
                </div>
            </div>
        </div>
        
        <footer>
            <p>Audio-Only WebRTC Chat Application | Built with HTML, CSS, and JavaScript</p>
        </footer>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="script.js"></script>
</body>
</html>

