document.addEventListener('DOMContentLoaded', function() {
    // UI Elements
    const startButton = document.getElementById('startButton');
    const stopButton = document.getElementById('stopButton');
    const createButton = document.getElementById('createButton');
    const joinButton = document.getElementById('joinButton');
    const hangupButton = document.getElementById('hangupButton');
    const toggleVideoButton = document.getElementById('toggleVideo');
    const toggleAudioButton = document.getElementById('toggleAudio');
    const screenShareButton = document.getElementById('screenShare');
    const startRecordingButton = document.getElementById('startRecording');
    const stopRecordingButton = document.getElementById('stopRecording');
    const recordingStatus = document.getElementById('recordingStatus');
    const roomInput = document.getElementById('roomInput');
    const statusText = document.getElementById('statusText');
    const connectionStatus = document.querySelector('.connection-status');
    const participantsList = document.getElementById('participantsList');
    const videoGrid = document.getElementById('videoGrid');
    const participantCount = document.getElementById('participantCount');
    
    // Templates
    const localVideoTemplate = document.getElementById('localVideoTemplate');
    const remoteVideoTemplate = document.getElementById('remoteVideoTemplate');
    
    // Application state
    let localStream = null;
    let screenStream = null;
    let roomName = '';
    let signalingSocket = null;
    let isCaller = false;
    let isVideoActive = true;
    let isAudioActive = true;
    let isScreenSharing = false;
    
    // Recording state
    let mediaRecorder = null;
    let audioChunks = [];
    let recordingId = null;
    let recordingStartTime = null;
    
    // Peer connections and user data
    const peerConnections = new Map(); // userId -> RTCPeerConnection
    const userData = new Map(); // userId -> user data
    const remoteStreams = new Map(); // userId -> MediaStream
    
    // WebRTC configuration
    const configuration = {
        iceServers: [
            { urls: 'stun:stun.l.google.com:19302' },
            { urls: 'stun:stun1.l.google.com:19302' },
            { urls: 'stun:stun2.l.google.com:19302' },
            { urls: 'stun:stun3.l.google.com:19302' },
            { urls: 'stun:stun4.l.google.com:19302' },
            {
                urls: 'turn:openrelay.metered.ca:80',
                username: 'openrelayproject',
                credential: 'openrelayproject'
            },
            {
                urls: 'turn:openrelay.metered.ca:443',
                username: 'openrelayproject',
                credential: 'openrelayproject'
            }
        ],
        iceTransportPolicy: 'all',
        bundlePolicy: 'max-bundle',
        rtcpMuxPolicy: 'require'
    };
    
    // Initialize Socket.IO connection
    function initSignaling() {
        console.log('Initializing signaling connection to:', window.location.origin);
        
        signalingSocket = io(window.location.origin, {
            transports: ['websocket', 'polling'],
            reconnection: true,
            reconnectionAttempts: 5,
            reconnectionDelay: 1000,
            timeout: 10000
        });
        
        // Debugging events
        signalingSocket.on('connect', () => {
            console.log('✅ Connected to signaling server with ID:', signalingSocket.id);
            updateStatus('Connected to server', 'connected');
            
            // Set our user data
            signalingSocket.emit('user-data', {
                name: 'User ' + signalingSocket.id.substring(0, 5),
                isVideoActive: isVideoActive,
                isAudioActive: isAudioActive
            });
        });
        
        signalingSocket.on('disconnect', (reason) => {
            console.log('❌ Disconnected from signaling server:', reason);
            updateStatus('Disconnected from server', 'disconnected');
        });
        
        signalingSocket.on('connect_error', (error) => {
            console.error('❌ Connection error:', error);
            updateStatus('Connection error: ' + error.message, 'disconnected');
        });
        
        signalingSocket.on('reconnect', (attempt) => {
            console.log('🔁 Reconnected after attempt:', attempt);
            updateStatus('Reconnected to server', 'connected');
        });
        
        // Application events
        signalingSocket.on('created', (room, id) => {
            console.log('✅ Room created:', room, 'by server');
            isCaller = true;
            updateStatus(`Created room: ${room}. Share this name with others.`, 'connected');
        });
        
        signalingSocket.on('joined', (room, id) => {
            console.log('✅ Room joined:', room, 'by server');
            updateStatus(`Joined room: ${room}. Waiting for participants...`, 'connected');
        });
        
        signalingSocket.on('user-joined', (data) => {
            console.log('✅ User joined:', data.userId, data.userData);
            updateStatus(`User ${data.userData?.name || data.userId.substring(0, 5)} joined`, 'connected');
            
            // Store user data
            if (data.userData) {
                userData.set(data.userId, data.userData);
            }
            
            // If we're the caller, create an offer to the new user
            if (isCaller && data.userId !== signalingSocket.id) {
                createPeerConnection(data.userId);
                createOffer(data.userId);
            }
        });
        
        signalingSocket.on('user-left', (data) => {
            console.log('👋 User left:', data.userId);
            updateStatus(`User ${userData.get(data.userId)?.name || data.userId.substring(0, 5)} left`, 'connected');
            
            // Clean up peer connection
            closePeerConnection(data.userId);
            
            // Remove user data
            userData.delete(data.userId);
            
            // Remove video element
            removeVideoElement(data.userId);
            
            // Update participant count
            updateParticipantCount();
        });
        
        signalingSocket.on('room-participants', (data) => {
            console.log('👥 Participants received:', data.participants);
            updateParticipantsList(data.participants);
            
            // Create peer connections for all participants
            data.participants.forEach(participant => {
                if (participant.id !== signalingSocket.id && !peerConnections.has(participant.id)) {
                    createPeerConnection(participant.id);
                    
                    // Store user data
                    if (participant.data) {
                        userData.set(participant.id, participant.data);
                    }
                    
                    // If we're the caller, create an offer
                    if (isCaller) {
                        createOffer(participant.id);
                    }
                }
            });
        });
        
        signalingSocket.on('user-updated', (data) => {
            console.log('🔄 User updated:', data.userId, data.userData);
            userData.set(data.userId, data.userData);
            updateVideoStatus(data.userId, data.userData.isVideoActive, data.userData.isAudioActive);
        });
        
        signalingSocket.on('offer', (data) => {
            console.log('📨 Received offer from:', data.from);
            if (!isCaller) {
                createPeerConnection(data.from);
                handleOffer(data.offer, data.from);
            }
        });
        
        signalingSocket.on('answer', (data) => {
            console.log('📨 Received answer from:', data.from);
            handleAnswer(data.answer, data.from);
        });
        
        signalingSocket.on('ice-candidate', (data) => {
            console.log('📨 Received ICE candidate from:', data.from);
            handleNewICECandidate(data.candidate, data.from);
        });
        
        signalingSocket.on('room-full', (data) => {
            console.log('❌ Room is full:', data.room);
            updateStatus(`Room "${data.room}" is full (max 5 participants). Please try another room.`, 'disconnected');
        });
        
        signalingSocket.on('recording-started', (data) => {
            console.log('🔴 Recording started:', data);
            recordingId = data.recordingId;
            recordingStatus.style.display = 'block';
            recordingStatus.textContent = `Recording: ${data.recordingId.substring(0, 8)}...`;
            startRecordingButton.disabled = true;
            stopRecordingButton.disabled = false;
        });
        
        signalingSocket.on('recording-stopped', (data) => {
            console.log('⏹️ Recording stopped:', data);
            recordingStatus.style.display = 'none';
            startRecordingButton.disabled = false;
            stopRecordingButton.disabled = true;
            
            // Show success message
            updateStatus('Recording saved successfully!', 'connected');
            setTimeout(() => {
                updateStatus(`In room: ${roomName}`, 'connected');
            }, 3000);
        });
        
        signalingSocket.on('recording-error', (data) => {
            console.error('❌ Recording error:', data.error);
            recordingStatus.style.display = 'none';
            startRecordingButton.disabled = false;
            stopRecordingButton.disabled = true;
            updateStatus('Recording error: ' + data.error, 'disconnected');
        });
        
        signalingSocket.on('recording-stop-confirm', (data) => {
            console.log('✅ Recording stop confirmed:', data);
            if (data.success) {
                recordingStatus.style.display = 'none';
                startRecordingButton.disabled = false;
                stopRecordingButton.disabled = true;
            }
        });
        
        signalingSocket.on('error', (data) => {
            console.error('❌ Server error:', data.error);
            updateStatus('Error: ' + data.error, 'disconnected');
        });
    }
    
    // Create a peer connection for a specific user
    function createPeerConnection(userId) {
        console.log('🔗 Creating peer connection for:', userId);
        
        if (peerConnections.has(userId)) {
            console.log('Peer connection already exists for:', userId);
            return;
        }
        
        try {
            const peerConnection = new RTCPeerConnection(configuration);
            
            // Add local stream to connection
            if (localStream) {
                localStream.getTracks().forEach(track => {
                    console.log('🎵 Adding track:', track.kind, 'to', userId);
                    peerConnection.addTrack(track, localStream);
                });
            }
            
            // Handle remote stream
            peerConnection.ontrack = (event) => {
                console.log('🎬 Remote stream received from:', userId, event.streams.length, 'streams');
                if (event.streams && event.streams[0]) {
                    remoteStreams.set(userId, event.streams[0]);
                    createVideoElement(userId, event.streams[0]);
                    updateParticipantCount();
                }
            };
            
            // Handle ICE candidates
            peerConnection.onicecandidate = (event) => {
                if (event.candidate) {
                    console.log('📤 Sending ICE candidate to:', userId);
                    signalingSocket.emit('ice-candidate', {
                        candidate: event.candidate,
                        to: userId,
                        roomId: roomName
                    });
                }
            };
            
            // Handle connection state changes
            peerConnection.onconnectionstatechange = () => {
                console.log('🔗 Connection state with', userId, ':', peerConnection.connectionState);
                
                if (peerConnection.connectionState === 'connected') {
                    updateStatus(`Connected to ${userData.get(userId)?.name || userId.substring(0, 5)}`, 'connected');
                } else if (peerConnection.connectionState === 'disconnected') {
                    updateStatus(`Connection with ${userData.get(userId)?.name || userId.substring(0, 5)} lost`, 'connecting');
                } else if (peerConnection.connectionState === 'failed') {
                    console.error('Connection failed with:', userId);
                }
            };
            
            peerConnections.set(userId, peerConnection);
            
        } catch (error) {
            console.error('❌ Error creating peer connection for', userId, ':', error);
        }
    }
    
    // Close a peer connection
    function closePeerConnection(userId) {
        if (peerConnections.has(userId)) {
            const pc = peerConnections.get(userId);
            pc.close();
            peerConnections.delete(userId);
            remoteStreams.delete(userId);
            console.log('🔌 Closed peer connection for:', userId);
        }
    }
    
    // Create a video element for a remote user
    function createVideoElement(userId, stream) {
        // Remove existing video element if any
        removeVideoElement(userId);
        
        const videoItem = remoteVideoTemplate.content.cloneNode(true);
        const videoElement = videoItem.querySelector('video');
        const userNameElement = videoItem.querySelector('.user-name');
        const videoStatusElement = videoItem.querySelector('.video-status');
        
        videoElement.id = `remoteVideo-${userId}`;
        videoElement.srcObject = stream;
        videoElement.autoplay = true;
        videoElement.playsInline = true;
        
        const user = userData.get(userId);
        userNameElement.textContent = user?.name || `User ${userId.substring(0, 5)}`;
        
        // Set initial status
        updateVideoStatusElement(videoStatusElement, user?.isAudioActive, user?.isVideoActive);
        
        videoGrid.appendChild(videoItem);
    }
    
    // Remove a video element
    function removeVideoElement(userId) {
        const videoElement = document.getElementById(`remoteVideo-${userId}`);
        if (videoElement) {
            videoElement.parentElement.remove();
        }
    }
    
    // Update video status indicators
    function updateVideoStatus(userId, isAudioActive, isVideoActive) {
        const videoElement = document.getElementById(`remoteVideo-${userId}`);
        if (videoElement) {
            const videoStatusElement = videoElement.parentElement.querySelector('.video-status');
            updateVideoStatusElement(videoStatusElement, isAudioActive, isVideoActive);
        }
    }
    
    // Update video status element
    function updateVideoStatusElement(element, isAudioActive, isVideoActive) {
        if (!element) return;
        
        const micIcon = element.querySelector('.fa-microphone');
        const videoIcon = element.querySelector('.fa-video');
        
        if (micIcon) {
            micIcon.className = isAudioActive ? 'fas fa-microphone' : 'fas fa-microphone-slash';
            micIcon.style.color = isAudioActive ? '#00ff00' : '#ff0000';
        }
        
        if (videoIcon) {
            videoIcon.className = isVideoActive ? 'fas fa-video' : 'fas fa-video-slash';
            videoIcon.style.color = isVideoActive ? '#00ff00' : '#ff0000';
        }
    }
    
    // Create offer for a specific user
    async function createOffer(userId) {
        try {
            const peerConnection = peerConnections.get(userId);
            if (!peerConnection) {
                console.error('No peer connection for:', userId);
                return;
            }
            
            console.log('📤 Creating offer for:', userId);
            const offer = await peerConnection.createOffer({
                offerToReceiveAudio: true,
                offerToReceiveVideo: true
            });
            
            await peerConnection.setLocalDescription(offer);
            console.log('📤 Sending offer to:', userId);
            signalingSocket.emit('offer', {
                offer: offer,
                to: userId,
                roomId: roomName
            });
        } catch (error) {
            console.error('❌ Error creating offer for', userId, ':', error);
        }
    }
    
    // Handle incoming offer
    async function handleOffer(offer, from) {
        try {
            const peerConnection = peerConnections.get(from);
            if (!peerConnection) {
                console.error('No peer connection for:', from);
                return;
            }
            
            console.log('📨 Handling offer from:', from);
            await peerConnection.setRemoteDescription(offer);
            const answer = await peerConnection.createAnswer({
                offerToReceiveAudio: true,
                offerToReceiveVideo: true
            });
            await peerConnection.setLocalDescription(answer);
            console.log('📤 Sending answer to:', from);
            signalingSocket.emit('answer', {
                answer: answer,
                to: from,
                roomId: roomName
            });
        } catch (error) {
            console.error('❌ Error handling offer from', from, ':', error);
        }
    }
    
    // Handle incoming answer
    async function handleAnswer(answer, from) {
        try {
            const peerConnection = peerConnections.get(from);
            if (!peerConnection) {
                console.error('No peer connection for:', from);
                return;
            }
            
            console.log('📨 Handling answer from:', from);
            await peerConnection.setRemoteDescription(answer);
            console.log('✅ Remote description set successfully for:', from);
        } catch (error) {
            console.error('❌ Error handling answer from', from, ':', error);
        }
    }
    
    // Handle new ICE candidate
    async function handleNewICECandidate(candidate, from) {
        try {
            const peerConnection = peerConnections.get(from);
            if (!peerConnection) {
                console.error('No peer connection for:', from);
                return;
            }
            
            console.log('📨 Adding ICE candidate from:', from);
            await peerConnection.addIceCandidate(candidate);
        } catch (error) {
            console.error('❌ Error adding ICE candidate from', from, ':', error);
        }
    }
    
    // Update status function
    function updateStatus(status, type) {
        console.log('📊 Status:', status);
        statusText.textContent = status;
        connectionStatus.className = 'connection-status ' + type;
    }
    
    // Update participants list
    function updateParticipantsList(participants) {
        participantsList.innerHTML = '';
        
        if (!participants || participants.length === 0) {
            participantsList.innerHTML = '<div class="participant">No participants yet</div>';
            return;
        }
        
        participants.forEach(participant => {
            const participantEl = document.createElement('div');
            participantEl.className = 'participant';
            participantEl.innerHTML = `
                <i class="fas fa-user"></i>
                ${participant.name || `User ${participant.id.substring(0, 5)}`}
                ${participant.id === signalingSocket?.id ? ' (You)' : ''}
            `;
            participantsList.appendChild(participantEl);
        });
        
        updateParticipantCount();
    }
    
    // Update participant count
    function updateParticipantCount() {
        const count = peerConnections.size + 1; // +1 for local user
        participantCount.textContent = count;
    }
    
    // Create local video element
    function createLocalVideoElement() {
        // Remove existing local video if any
        const existingLocalVideo = document.getElementById('localVideo');
        if (existingLocalVideo) {
            existingLocalVideo.parentElement.remove();
        }
        
        const videoItem = localVideoTemplate.content.cloneNode(true);
        const videoElement = videoItem.querySelector('video');
        const videoStatusElement = videoItem.querySelector('.video-status');
        
        videoElement.srcObject = localStream;
        videoElement.autoplay = true;
        videoElement.playsInline = true;
        videoElement.muted = true;
        
        updateVideoStatusElement(videoStatusElement, isAudioActive, isVideoActive);
        
        videoGrid.appendChild(videoItem);
    }
    
    // Toggle video
    async function toggleVideo() {
        if (!localStream) return;
        
        const videoTracks = localStream.getVideoTracks();
        if (videoTracks.length > 0) {
            isVideoActive = !isVideoActive;
            videoTracks[0].enabled = isVideoActive;
            
            // Update UI
            toggleVideoButton.innerHTML = isVideoActive ? 
                '<i class="fas fa-video"></i> Video On' : 
                '<i class="fas fa-video-slash"></i> Video Off';
            toggleVideoButton.classList.toggle('active', isVideoActive);
            
            // Update user data
            if (signalingSocket) {
                signalingSocket.emit('user-data', {
                    name: 'User ' + signalingSocket.id.substring(0, 5),
                    isVideoActive: isVideoActive,
                    isAudioActive: isAudioActive
                });
            }
            
            // Update local video status
            const videoStatusElement = document.querySelector('.local-video .video-status');
            updateVideoStatusElement(videoStatusElement, isAudioActive, isVideoActive);
        }
    }
    
    // Toggle audio
    async function toggleAudio() {
        if (!localStream) return;
        
        const audioTracks = localStream.getAudioTracks();
        if (audioTracks.length > 0) {
            isAudioActive = !isAudioActive;
            audioTracks[0].enabled = isAudioActive;
            
            // Update UI
            toggleAudioButton.innerHTML = isAudioActive ? 
                '<i class="fas fa-microphone"></i> Audio On' : 
                '<i class="fas fa-microphone-slash"></i> Audio Off';
            toggleAudioButton.classList.toggle('active', isAudioActive);
            
            // Update user data
            if (signalingSocket) {
                signalingSocket.emit('user-data', {
                    name: 'User ' + signalingSocket.id.substring(0, 5),
                    isVideoActive: isVideoActive,
                    isAudioActive: isAudioActive
                });
            }
            
            // Update local video status
            const videoStatusElement = document.querySelector('.local-video .video-status');
            updateVideoStatusElement(videoStatusElement, isAudioActive, isVideoActive);
        }
    }
    
    // Share screen
    async function shareScreen() {
        try {
            if (isScreenSharing) {
                // Stop screen sharing
                if (screenStream) {
                    screenStream.getTracks().forEach(track => track.stop());
                }
                
                // Switch back to camera
                const videoTrack = localStream.getVideoTracks()[0];
                if (videoTrack) {
                    // Replace the video track in all peer connections
                    for (const [userId, pc] of peerConnections) {
                        const sender = pc.getSenders().find(s => 
                            s.track && s.track.kind === 'video');
                        if (sender) {
                            await sender.replaceTrack(videoTrack);
                        }
                    }
                }
                
                isScreenSharing = false;
                screenShareButton.innerHTML = '<i class="fas fa-desktop"></i> Share Screen';
                screenShareButton.classList.remove('active');
            } else {
                // Start screen sharing
                screenStream = await navigator.mediaDevices.getDisplayMedia({
                    video: true,
                    audio: false
                });
                
                // Replace the video track in all peer connections
                const videoTrack = screenStream.getVideoTracks()[0];
                for (const [userId, pc] of peerConnections) {
                    const sender = pc.getSenders().find(s => 
                        s.track && s.track.kind === 'video');
                    if (sender) {
                        await sender.replaceTrack(videoTrack);
                    }
                }
                
                // Handle when the user stops screen sharing
                videoTrack.onended = () => {
                    shareScreen();
                };
                
                isScreenSharing = true;
                screenShareButton.innerHTML = '<i class="fas fa-times"></i> Stop Sharing';
                screenShareButton.classList.add('active');
            }
        } catch (error) {
            console.error('Error sharing screen:', error);
        }
    }
    
    // Start recording
    async function startRecording() {
        try {
            if (!localStream) {
                alert('Please start media first');
                return;
            }
            
            if (!roomName) {
                alert('Please join a room first');
                return;
            }
            
            console.log('🎙️ Starting recording for room:', roomName);
            
            // Notify server to start recording
            signalingSocket.emit('start-recording', {
                roomId: roomName,
                roomName: roomName
            });
            
            // Create media recorder for audio only
            const audioTracks = localStream.getAudioTracks();
            if (audioTracks.length > 0) {
                const audioStream = new MediaStream(audioTracks);
                mediaRecorder = new MediaRecorder(audioStream, {
                    mimeType: 'audio/webm;codecs=opus'
                });
                
                audioChunks = [];
                mediaRecorder.ondataavailable = (event) => {
                    if (event.data.size > 0) {
                        audioChunks.push(event.data);
                    }
                };
                
                mediaRecorder.onstop = async () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    await uploadRecording(audioBlob);
                };
                
                mediaRecorder.start(1000); // Collect data every second
                recordingStartTime = Date.now();
                
                // Update UI
                startRecordingButton.disabled = true;
                stopRecordingButton.disabled = false;
                recordingStatus.style.display = 'block';
                recordingStatus.textContent = 'Recording...';
            }
        } catch (error) {
            console.error('Error starting recording:', error);
            alert('Failed to start recording: ' + error.message);
        }
    }
    
    // Stop recording
    async function stopRecording() {
        try {
            if (mediaRecorder && mediaRecorder.state === 'recording') {
                mediaRecorder.stop();
                
                // Calculate duration
                const duration = Math.floor((Date.now() - recordingStartTime) / 1000);
                
                // Get participant IDs
                const participants = Array.from(peerConnections.keys());
                
                // Notify server to stop recording
                signalingSocket.emit('stop-recording', {
                    roomId: roomName,
                    roomName: roomName,
                    recordingId: recordingId,
                    duration: duration,
                    participants: participants
                });
                
                console.log('⏹️ Stopping recording, duration:', duration, 'participants:', participants);
            }
        } catch (error) {
            console.error('Error stopping recording:', error);
            alert('Failed to stop recording: ' + error.message);
        }
    }
    
    // Upload recording to server
    async function uploadRecording(audioBlob) {
        try {
            const formData = new FormData();
            formData.append('recording', audioBlob, `recording-${recordingId}.webm`);
            formData.append('roomId', roomName);
            formData.append('recordingId', recordingId);
            formData.append('duration', Math.floor((Date.now() - recordingStartTime) / 1000));
            formData.append('participants', JSON.stringify(Array.from(peerConnections.keys())));
            formData.append('createdBy', signalingSocket.id);
            
            const response = await fetch('/api/recordings/upload', {
                method: 'POST',
                body: formData
            });
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                console.log('Recording uploaded successfully:', result.recording);
            } else {
                throw new Error(result.error || 'Failed to upload recording');
            }
        } catch (error) {
            console.error('Error uploading recording:', error);
        }
    }
    
    // Hang up call
    function hangupCall() {
        console.log('📞 Hanging up call');
        
        // Close all peer connections
        for (const [userId, pc] of peerConnections) {
            pc.close();
        }
        peerConnections.clear();
        remoteStreams.clear();
        
        if (signalingSocket) {
            signalingSocket.emit('leave', roomName);
        }
        
        // Remove all remote video elements
        document.querySelectorAll('.remote-video').forEach(el => el.remove());
        
        hangupButton.disabled = true;
        isCaller = false;
        roomName = '';
        
        updateStatus('Call ended', 'disconnected');
        updateParticipantCount();
    }
    
    // Start media (audio and video)
    startButton.addEventListener('click', async () => {
        try {
            updateStatus('Accessing camera and microphone...', 'connecting');
            
            // Get user media with both audio and video
            localStream = await navigator.mediaDevices.getUserMedia({ 
                audio: {
                    echoCancellation: true,
                    noiseSuppression: true,
                    autoGainControl: true,
                    channelCount: 1,
                    sampleRate: 48000,
                    sampleSize: 16
                }, 
                video: {
                    width: { ideal: 1280 },
                    height: { ideal: 720 },
                    frameRate: { ideal: 30 }
                }
            });
            
            // Create local video element
            createLocalVideoElement();
            
            // Update UI
            updateStatus('Camera and microphone active', 'connected');
            startButton.disabled = true;
            stopButton.disabled = false;
            createButton.disabled = false;
            joinButton.disabled = false;
            hangupButton.disabled = false;
            toggleVideoButton.disabled = false;
            toggleAudioButton.disabled = false;
            screenShareButton.disabled = false;
            startRecordingButton.disabled = false;
            
            // Initialize signaling
            initSignaling();
            
        } catch (error) {
            console.error('❌ Error accessing media devices:', error);
            
            // Show detailed error message
            if (error.name === 'NotAllowedError') {
                updateStatus('Camera/microphone permission denied. Please allow access.', 'disconnected');
            } else if (error.name === 'NotFoundError') {
                updateStatus('No camera/microphone found. Please connect devices.', 'disconnected');
            } else if (error.name === 'NotReadableError') {
                updateStatus('Camera/microphone is already in use by another application.', 'disconnected');
            } else {
                updateStatus('Error accessing media: ' + error.message, 'disconnected');
            }
        }
    });
    
    // Stop media
    stopButton.addEventListener('click', () => {
        if (localStream) {
            localStream.getTracks().forEach(track => track.stop());
            localStream = null;
        }
        
        if (screenStream) {
            screenStream.getTracks().forEach(track => track.stop());
            screenStream = null;
        }
        
        // Stop recording if active
        if (mediaRecorder && mediaRecorder.state === 'recording') {
            mediaRecorder.stop();
        }
        
        hangupCall();
        
        // Remove local video element
        const localVideo = document.getElementById('localVideo');
        if (localVideo) {
            localVideo.parentElement.remove();
        }
        
        updateStatus('Camera and microphone stopped', 'disconnected');
        startButton.disabled = false;
        stopButton.disabled = true;
        createButton.disabled = true;
        joinButton.disabled = true;
        hangupButton.disabled = true;
        toggleVideoButton.disabled = true;
        toggleAudioButton.disabled = true;
        screenShareButton.disabled = true;
        startRecordingButton.disabled = true;
        stopRecordingButton.disabled = true;
        recordingStatus.style.display = 'none';
    });
    
    // Create a room
    createButton.addEventListener('click', () => {
        if (!localStream) {
            updateStatus('Please start media first', 'disconnected');
            return;
        }
        
        roomName = roomInput.value.trim() || 'room-' + Math.random().toString(36).substring(2, 8);
        if (!roomName) {
            updateStatus('Please enter a room name', 'disconnected');
            return;
        }
        
        updateStatus(`Creating room: ${roomName}...`, 'connecting');
        signalingSocket.emit('create-or-join-room', roomName, {
            name: 'User ' + signalingSocket.id.substring(0, 5),
            isVideoActive: isVideoActive,
            isAudioActive: isAudioActive
        });
    });
    
    // Join a room
    joinButton.addEventListener('click', () => {
        if (!localStream) {
            updateStatus('Please start media first', 'disconnected');
            return;
        }
        
        roomName = roomInput.value.trim();
        if (!roomName) {
            updateStatus('Please enter a room name', 'disconnected');
            return;
        }
        
        updateStatus(`Joining room: ${roomName}...`, 'connecting');
        signalingSocket.emit('create-or-join-room', roomName, {
            name: 'User ' + signalingSocket.id.substring(0, 5),
            isVideoActive: isVideoActive,
            isAudioActive: isAudioActive
        });
    });
    
    // Hang up the call
    hangupButton.addEventListener('click', () => {
        hangupCall();
    });
    
    // Toggle video button
    toggleVideoButton.addEventListener('click', toggleVideo);
    
    // Toggle audio button
    toggleAudioButton.addEventListener('click', toggleAudio);
    
    // Screen share button
    screenShareButton.addEventListener('click', shareScreen);
    
    // Recording buttons
    startRecordingButton.addEventListener('click', startRecording);
    stopRecordingButton.addEventListener('click', stopRecording);
    
    // Add keyboard shortcuts
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && roomInput.value.trim()) {
            if (createButton.disabled === false) {
                createButton.click();
            }
        }
        
        if (event.key === 'Escape') {
            hangupButton.click();
        }
    });
    
    console.log('✅ WebRTC Video Conference App initialized');
    console.log('🌐 User Agent:', navigator.userAgent);
});
