const express = require('express');
const http = require('http');
const socketIo = require('socket.io');
const path = require('path');

const app = express();
const server = http.createServer(app);
const io = socketIo(server, {
    cors: {
        origin: "*",
        methods: ["GET", "POST"]
    }
});

const PORT = process.env.PORT || 3000;

// Serve static files from the client directory
app.use(express.static(path.join(__dirname, '../client')));

// Root route - serve index.html
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, '../client/index.html'));
});

// Store active rooms
const rooms = new Map();

// Store socket connections
const connections = new Map();

io.on('connection', (socket) => {
    console.log('User connected:', socket.id);
    console.log('Total users connected:', io.engine.clientsCount);
    
    connections.set(socket.id, { 
        connectedAt: new Date(),
        ip: socket.handshake.address 
    });

    socket.on('create-or-join-room', (roomName) => {
        console.log('Create or join room:', roomName, 'by user:', socket.id);
        
        const room = rooms.get(roomName) || { users: [] };
        
        if (room.users.length >= 2) {
            console.log('Room is full:', roomName);
            socket.emit('room-full');
            return;
        }

        room.users.push(socket.id);
        rooms.set(roomName, room);
        socket.join(roomName);
        
        // Update connection info
        connections.set(socket.id, { 
            ...connections.get(socket.id), 
            room: roomName,
            joinedAt: new Date()
        });
        
        // Notify all users in the room about updated participants
        io.to(roomName).emit('participants-updated', room.users);
        
        if (room.users.length === 1) {
            console.log('Room created:', roomName, 'by user:', socket.id);
            socket.emit('created', roomName, socket.id);
        } else {
            console.log('Room joined:', roomName, 'by user:', socket.id);
            socket.emit('joined', roomName, socket.id);
            // Notify the first user that someone joined
            const firstUser = room.users[0];
            if (firstUser && firstUser !== socket.id) {
                socket.to(firstUser).emit('ready', roomName);
            }
        }
        
        console.log('Room', roomName, 'now has', room.users.length, 'users');
    });

    socket.on('offer', (offer, roomName, to) => {
        console.log('Offer from:', socket.id, 'to:', to, 'room:', roomName);
        if (to && socket.id !== to) {
            socket.to(to).emit('offer', offer, socket.id);
        } else {
            console.error('Invalid target for offer:', to);
        }
    });

    socket.on('answer', (answer, roomName, to) => {
        console.log('Answer from:', socket.id, 'to:', to, 'room:', roomName);
        if (to && socket.id !== to) {
            socket.to(to).emit('answer', answer, socket.id);
        } else {
            console.error('Invalid target for answer:', to);
        }
    });

    socket.on('ice-candidate', (candidate, roomName, to) => {
        console.log('ICE candidate from:', socket.id, 'to:', to, 'room:', roomName);
        if (to && socket.id !== to) {
            socket.to(to).emit('ice-candidate', candidate, socket.id);
        } else {
            console.error('Invalid target for ICE candidate:', to);
        }
    });

    socket.on('ready', (roomName) => {
        console.log('User ready:', socket.id, 'in room:', roomName);
        const room = rooms.get(roomName);
        if (room) {
            // Notify all other users in the room
            room.users.forEach(userId => {
                if (userId !== socket.id) {
                    socket.to(userId).emit('user-ready', socket.id);
                }
            });
        }
    });

    socket.on('leave', (roomName) => {
        console.log('User leaving:', socket.id, 'from room:', roomName);
        leaveRoom(socket.id, roomName);
    });

    socket.on('get-rooms', () => {
        const roomList = [];
        for (let [roomName, room] of rooms) {
            roomList.push({
                name: roomName,
                users: room.users.length,
                userList: room.users
            });
        }
        socket.emit('rooms-list', roomList);
    });

    socket.on('disconnect', (reason) => {
        console.log('User disconnected:', socket.id, 'Reason:', reason);
        
        // Clean up room data when users disconnect
        for (let [roomName, room] of rooms) {
            const index = room.users.indexOf(socket.id);
            if (index !== -1) {
                room.users.splice(index, 1);
                io.to(roomName).emit('user-left', socket.id);
                
                if (room.users.length === 0) {
                    console.log('Deleting empty room:', roomName);
                    rooms.delete(roomName);
                } else {
                    // Notify remaining users about updated participants
                    io.to(roomName).emit('participants-updated', room.users);
                }
            }
        }
        
        // Remove from connections
        connections.delete(socket.id);
        console.log('Total users remaining:', io.engine.clientsCount);
    });

    function leaveRoom(userId, roomName) {
        const room = rooms.get(roomName);
        if (room) {
            const index = room.users.indexOf(userId);
            if (index !== -1) {
                room.users.splice(index, 1);
                io.to(roomName).emit('user-left', userId);
                
                if (room.users.length === 0) {
                    console.log('Deleting empty room:', roomName);
                    rooms.delete(roomName);
                } else {
                    // Notify remaining users about updated participants
                    io.to(roomName).emit('participants-updated', room.users);
                }
            }
        }
    }
});

// Health check endpoint
app.get('/health', (req, res) => {
    res.json({
        status: 'ok',
        users: io.engine.clientsCount,
        rooms: rooms.size,
        timestamp: new Date().toISOString()
    });
});

// Get rooms info endpoint
app.get('/api/rooms', (req, res) => {
    const roomList = [];
    for (let [roomName, room] of rooms) {
        roomList.push({
            name: roomName,
            users: room.users.length,
            userIds: room.users
        });
    }
    res.json(roomList);
});

// Get connections info endpoint
app.get('/api/connections', (req, res) => {
    const connectionList = [];
    for (let [socketId, info] of connections) {
        connectionList.push({
            id: socketId,
            room: info.room || 'none',
            connectedAt: info.connectedAt,
            joinedAt: info.joinedAt || 'not joined',
            ip: info.ip
        });
    }
    res.json(connectionList);
});

server.listen(PORT, '0.0.0.0', () => {
    console.log(`✅ Audio WebRTC server running on port ${PORT}`);
    console.log(`✅ Health check: http://localhost:${PORT}/health`);
    console.log(`✅ Rooms API: http://localhost:${PORT}/api/rooms`);
    console.log(`✅ Connections API: http://localhost:${PORT}/api/connections`);
});

