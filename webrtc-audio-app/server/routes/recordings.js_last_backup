const express = require('express');
const router = express.Router();
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const { saveRecording, getRecordings } = require('../database/models');

// Ensure recordings directory exists
const recordingsDir = path.join(__dirname, '../storage/recordings');
if (!fs.existsSync(recordingsDir)) {
  fs.mkdirSync(recordingsDir, { recursive: true });
}

// Configure multer for file uploads
const storage = multer.diskStorage({
  destination: (req, file, cb) => {
    cb(null, recordingsDir);
  },
  filename: (req, file, cb) => {
    const uniqueSuffix = Date.now() + '-' + Math.round(Math.random() * 1E9);
    cb(null, 'recording-' + uniqueSuffix + '.wav');
  }
});

const upload = multer({ 
  storage: storage,
  limits: {
    fileSize: 100 * 1024 * 1024 // 100MB limit
  },
  fileFilter: (req, file, cb) => {
    if (file.mimetype === 'audio/wav' || file.originalname.endsWith('.wav')) {
      cb(null, true);
    } else {
      cb(new Error('Only WAV files are allowed'), false);
    }
  }
});

// Upload recording
router.post('/upload', upload.single('recording'), async (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ error: 'No file uploaded' });
    }

    const { roomId, recordingId, duration, participants, createdBy } = req.body;
    
    if (!roomId || !recordingId) {
      // Delete the uploaded file if metadata is missing
      fs.unlinkSync(req.file.path);
      return res.status(400).json({ error: 'roomId and recordingId are required' });
    }

    // Save recording metadata to database
    const recordingData = {
      recordingId,
      roomId,
      fileName: req.file.originalname,
      filePath: req.file.path,
      fileSize: req.file.size,
      duration: parseInt(duration) || 0,
      participants: participants ? JSON.parse(participants) : [],
      createdBy: createdBy || 'unknown'
    };

    const savedRecording = await saveRecording(recordingData);
    
    res.json({
      success: true,
      recording: savedRecording
    });
  } catch (error) {
    console.error('Error uploading recording:', error);
    res.status(500).json({ error: error.message });
  }
});

// Get recording file
router.get('/:recordingId/file', async (req, res) => {
  try {
    const recordings = await getRecordings();
    const recording = recordings.find(r => r.recording_id === req.params.recordingId);
    
    if (!recording) {
      return res.status(404).json({ error: 'Recording not found' });
    }
    
    if (!fs.existsSync(recording.file_path)) {
      return res.status(404).json({ error: 'Recording file not found' });
    }
    
    res.setHeader('Content-Type', 'audio/wav');
    res.setHeader('Content-Disposition', `attachment; filename="${recording.file_name}"`);
    
    const fileStream = fs.createReadStream(recording.file_path);
    fileStream.pipe(res);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// Delete recording
router.delete('/:recordingId', async (req, res) => {
  try {
    const recordings = await getRecordings();
    const recording = recordings.find(r => r.recording_id === req.params.recordingId);
    
    if (!recording) {
      return res.status(404).json({ error: 'Recording not found' });
    }
    
    // Delete file from storage
    if (fs.existsSync(recording.file_path)) {
      fs.unlinkSync(recording.file_path);
    }
    
    // Delete from database (you'll need to implement this function)
    // await deleteRecording(req.params.recordingId);
    
    res.json({ success: true, message: 'Recording deleted successfully' });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

module.exports = router;
